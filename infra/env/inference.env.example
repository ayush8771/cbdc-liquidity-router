# Inference service (FastAPI). Contract §8. Copy to infra/env/inference.env (git-ignored).
# Values shown are the contract defaults. No secrets belong in this file.

# Repository root; engine workers chdir here. Container: /repo. Local: the repo checkout.
CBDC_REPO_ROOT=.
# Approval-registry entry for ppo_projected. Leave empty to keep ppo_projected disabled.
CBDC_PPO_CHECKPOINT_ID=
# cpu or cuda
CBDC_DEVICE=cpu
CBDC_ENGINE_WORKERS=2
CBDC_ENGINE_TASK_TIMEOUT_S=10
# Must stay below the backend's INFERENCE_TIMEOUT_MS (15000 ms).
CBDC_ENGINE_REQUEST_DEADLINE_S=12
# Provisional. Startup requires 0 <= value < CBDC_ENGINE_REQUEST_DEADLINE_S.
CBDC_ENGINE_MIN_START_BUDGET_S=1
CBDC_ENGINE_STARTUP_TIMEOUT_S=180
CBDC_ENGINE_MAX_QUEUE=32
# Optional Cognee support (needs local Ollama and the cognee lock). semantic_context stays null in API v1.
CBDC_ENABLE_COGNEE=false
