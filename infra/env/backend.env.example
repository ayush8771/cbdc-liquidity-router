# Application backend (Express). Contract §8. Copy to infra/env/backend.env (git-ignored).
# No real credentials in this file. Replace the placeholder database password locally.

# live or mock (in-process fixture stub)
INFERENCE_MODE=live
# Compose-internal address. For a local, non-Compose run use http://127.0.0.1:8000.
INFERENCE_URL=http://inference:8000
# Must stay above the engine's 12 s end-to-end deadline.
INFERENCE_TIMEOUT_MS=15000
# Required. Must be "dev"; anything else stops startup.
AUTH_MODE=dev
# Git-ignored token-hash file; copy services/backend/dev-tokens.example.json to create it.
DEV_TOKENS_FILE=./dev-tokens.json
# Placeholder password; must match POSTGRES_PASSWORD in postgres.env. Host "postgres" is the Compose service.
DATABASE_URL=postgresql://cbdc:CHANGE_ME_LOCAL_ONLY@postgres:5432/cbdc
